# Local development
DATABASE_URL=sqlite+aiosqlite:///./cityflow_dev.db
FRONTEND_ORIGIN=http://localhost:3000

# mock | hybrid | live
# hybrid = live traffic/incidents/weather/routing + mock transit/safety/prediction
PROVIDER_MODE=mock

# Authentication remains disabled until Supabase Auth is wired.
AUTH_MODE=mock
AUTH_ENABLED=false

# TomTom - required for traffic, incidents and vehicle routing in live/hybrid mode
TOMTOM_API_KEY=
TOMTOM_BASE_URL=https://api.tomtom.com

# Open-Meteo is keyless for normal public API usage.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_AQI_BASE_URL=https://air-quality-api.open-meteo.com/v1

# Production example:
# FRONTEND_ORIGIN=https://your-app.vercel.app
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
